# Baked into the v1 agent image at build time and read by agent-supervisor
# on startup. This -- not a ConfigMap, not an inline Deployment env: value
# -- is the source of truth for this agent's identity. Only the credential
# (BLUEPRINT_TOKEN) comes from a Kubernetes Secret instead; everything here
# is non-sensitive and travels with the image it describes, so a version
# bump can never drift out of sync with the image tag the way a
# separately-maintained env: value could.
BLUEPRINT_ID=bp-8891
AGENT_IMAGE=ubs-poc/demo-agent:v1
UBS_API_BASE=http://mock-ubs-api.ubs-poc-v2.svc.cluster.local:5000
